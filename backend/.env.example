# Database. Production (Railway): postgresql+psycopg://usuario:senha@host:5432/db
DATABASE_URL=sqlite:///./culturetrack.db

# JWT API Secret.
# Generate with the command: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=jwt_placeholder
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# REQUIRED. Same as front GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your_google_client_id